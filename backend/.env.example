# Backend env vars — all required; app hard-fails at boot if any is missing (SECURITY.md §1)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_ORIGIN=http://localhost:3000
# Perplexity sonar key for judge-triggered fact-checks (M3). Required — backend-only.
PERPLEXITY_API_KEY=
# Optional: daily global LLM-call ceiling for the spend circuit breaker (default 200).
DAILY_LLM_CALL_CEILING=200
