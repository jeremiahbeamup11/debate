# Public frontend config — no secrets here ever (SECURITY.md §1).
# The three NEXT_PUBLIC_SUPABASE/BACKEND vars are required; the app throws at boot if missing.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# PostHog project key (public, not a secret). If unset, analytics is disabled with a console warning.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
